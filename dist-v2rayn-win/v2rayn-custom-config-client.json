{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "cs2world",
      "tag": "cs2world-out",
      "server": "YOUR_VPS_IP",
      "server_port": 27015,
      "psk": "YOUR_PSK",
      "kcp": {
        "data_shards": 10,
        "parity_shards": 3,
        "mtu": 1180,
        "snd_wnd": 1024,
        "rcv_wnd": 1024
      },
      "shaper": {
        "enabled": true,
        "tick_rate_hz": 64,
        "idle_sleep_seconds": 600,
        "combat_mean_bytes": 180,
        "fastdl_chunk_size": 1248
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "final": "cs2world-out"
  }
}
